    <!-- http://www.semanticweb.org/ontologies/football#playsFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/football#playsFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
